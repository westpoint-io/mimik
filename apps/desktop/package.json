{
  "name": "@mimik/desktop",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:capture": "electron-vite build && electron out/main/check-capture.js",
    "check:storage": "electron-vite build && electron out/main/check-storage.js",
    "check:overlay": "electron-vite build && node scripts/run-check.mjs out/main/check-overlay.js",
    "check:pipeline": "electron-vite build && electron out/main/check-pipeline.js"
  },
  "dependencies": {
    "@mimik/capture-native": "workspace:*",
    "@mimik/core": "workspace:*",
    "@mimik/ui": "workspace:*",
    "dexie": "^4.3.0",
    "electron-updater": "^6.6.2",
    "get-windows": "^9.3.0",
    "node-screenshots": "^0.2.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uiohook-napi": "^1.5.5",
    "xstate": "^5.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "js-yaml": "^4.1.0",
    "lucide": "^1.47.0",
    "tailwindcss": "^4.2.2",
    "vite": "^6.0.3"
  },
  "description": "Mimik desktop shell",
  "author": {
    "name": "Westpoint",
    "email": "hello@westpoint.io"
  }
}
