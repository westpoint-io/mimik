{
  "name": "mimik",
  "version": "1.3.0",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:firefox",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mimik/core": "workspace:*",
    "@mimik/ui": "workspace:*",
    "@webext-core/messaging": "^2.3.0",
    "lucide-react": "^0.577.0",
    "p-queue": "^9.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-react": "^1.2.2",
    "size-limit": "^14.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wxt": "^0.21.4"
  },
  "size-limit": [
    {
      "name": "background",
      "path": ".output/chrome-mv3/background.js",
      "limit": "170 kB"
    },
    {
      "name": "content script",
      "path": ".output/chrome-mv3/content-scripts/*.js",
      "limit": "40 kB"
    },
    {
      "name": "pages",
      "path": ".output/chrome-mv3/chunks/*.js",
      "limit": "600 kB"
    }
  ]
}
