{
  "name": "mimik",
  "version": "1.3.0",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:firefox",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@mimik/core": "workspace:*",
    "@mimik/ui": "workspace:*",
    "@webext-core/messaging": "^4.0.1",
    "lucide-react": "^1.62.0",
    "p-queue": "^10.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-react": "^1.2.2",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "size-limit": [
    {
      "name": "background",
      "path": ".output/chrome-mv3/background.js",
      "limit": "170 kB"
    },
    {
      "name": "content script",
      "path": ".output/chrome-mv3/content-scripts/*.js",
      "limit": "112 kB"
    },
    {
      "name": "pages",
      "path": ".output/chrome-mv3/chunks/*.js",
      "limit": "620 kB"
    }
  ]
}
