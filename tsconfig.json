{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["vitest.config.ts", "vitest.setup.ts", "packages/locales/**/*"]
}
