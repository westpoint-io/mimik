{
  "name": "mimik-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter mimik dev",
    "dev:firefox": "pnpm --filter mimik dev:firefox",
    "build": "pnpm --filter mimik build",
    "build:firefox": "pnpm --filter mimik build:firefox",
    "zip": "pnpm --filter mimik zip",
    "zip:firefox": "pnpm --filter mimik zip:firefox",
    "zip:all": "pnpm --filter mimik zip:all",
    "size": "pnpm --filter mimik size",
    "dev:desktop": "pnpm --filter @mimik/desktop dev",
    "build:desktop": "pnpm --filter @mimik/desktop build",
    "pack:desktop": "pnpm --filter @mimik/desktop run pack",
    "typecheck": "pnpm --filter mimik typecheck && pnpm --filter @mimik/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "biome check . && node scripts/check-exports.mjs && node scripts/check-locale-keys.mjs && node scripts/check-capture-states.mjs && jscpd && knip --no-progress",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky .github/husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "knip": {
    "ignoreUnresolved": [
      "#imports"
    ],
    "ignoreDependencies": [
      "@mimik/locales"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.mjs"
        ],
        "project": [
          "scripts/**"
        ]
      },
      "apps/extension": {
        "entry": [
          "src/entrypoints/*.ts",
          "src/entrypoints/*/index.{ts,tsx}"
        ],
        "project": [
          "src/**/*.{ts,tsx}"
        ],
        "ignoreDependencies": [
          "@fontsource/poppins"
        ]
      },
      "apps/desktop": {
        "entry": [
          "src/preload/*.ts",
          "src/renderer/*.html",
          "scripts/*.{ts,mjs,cjs}"
        ],
        "project": [
          "src/**/*.{ts,tsx}",
          "scripts/**"
        ],
        "ignoreDependencies": [
          "@fontsource/poppins",
          "tailwindcss"
        ]
      },
      "packages/core": {
        "includeEntryExports": true,
        "project": [
          "src/**/*.ts"
        ],
        "ignore": [
          "src/export/empty.ts"
        ]
      },
      "packages/ui": {
        "includeEntryExports": true,
        "project": [
          "src/**/*.{ts,tsx}"
        ],
        "ignore": [
          "src/components/ui/**"
        ]
      },
      "packages/capture-native": {
        "ignore": [
          "index.js"
        ]
      }
    }
  },
  "jscpd": {
    "path": [
      "apps/extension/src",
      "apps/desktop/src",
      "packages/core/src",
      "packages/ui/src"
    ],
    "format": [
      "typescript",
      "tsx"
    ],
    "minLines": 12,
    "minTokens": 80,
    "threshold": 0.5,
    "ignore": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/components/ui/**"
    ],
    "reporters": [
      "console"
    ],
    "silent": true
  }
}
